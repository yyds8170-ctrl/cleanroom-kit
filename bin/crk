#!/bin/sh
# cleanroom-kit 启动器（macOS/Linux）。无需安装，直接调用。
ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
PY=""
for candidate in "${PYTHON:-python3}" python3 python; do
    command -v "$candidate" >/dev/null 2>&1 && PY="$candidate" && break
done
if [ -z "$PY" ]; then
    echo "未找到 Python 解释器（python3 / python），请先安装 Python 3。" >&2
    exit 1
fi
exec "$PY" -m crkit "$@"
